# NexusPMT — copy to .env via: python scripts/setup_credentials.py
# NEVER commit .env

# --- Operator ---
NEXUSPMT_OPERATOR_TOKEN=change-me-operator-token
NEXUSPMT_HOST=0.0.0.0
NEXUSPMT_PORT=8080

# --- WorldMap (internal Docker hostname on somykida_net) ---
WORLDMAP_BASE_URL=http://sk-ai-worldmap:8080
WORLDMAP_HEALTH_PATH=/api/sidecar-health
WORLDMAP_POLL_INTERVAL_SEC=30
WORLDMAP_REQUIRED=true
WORLDMAP_CONTAINER_NAME=sk-ai-worldmap
WORLDMAP_COMPOSE_PROJECT=sk-ai-worldmap

# --- Kalshi V2 ---
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi_private.pem
# demo | production
KALSHI_ENV=demo
# paper | live  (prod image defaults to paper)
KALSHI_TRADING_MODE=paper
KALSHI_SPORTS_FILTER=strict
KALSHI_CATEGORY_ALLOWLIST=Economics,Politics,Elections,Climate and Weather,Companies,Financials,Science and Technology,Crypto,World
KALSHI_CATEGORY_BLOCKLIST=Sports,Entertainment
KALSHI_MIN_EDGE=0.05
KALSHI_MAX_SPREAD=0.08
KALSHI_MIN_LIQUIDITY=100
KALSHI_MAX_NOTIONAL_CENTS=2500
KALSHI_MAX_OPEN_POSITIONS=10
KALSHI_REQUIRE_APPROVAL_ABOVE_CENTS=1000

# --- SpaceXAI / xAI (Futures Wheel) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# --- Risk / fail-safes ---
RISK_MAX_DAILY_LOSS_CENTS=5000
RISK_MAX_DRAWDOWN_PCT=15
RISK_AUTO_KILL_ON_ERRORS=5
